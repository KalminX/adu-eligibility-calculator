# ==============================================================================
# Environment Configuration Template (Safe Placeholders)
# Copy this file to .env for local development: cp .env.example .env
# Never commit real credentials to version control.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-development-placeholder-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database Configuration
# Leave empty for local SQLite; provide PostgreSQL URL for Neon / production:
# Example Neon URL: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Email Integration (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
LEAD_NOTIFICATION_EMAIL=admin@example.com

# WhatsApp Integration (Meta Cloud API / Mock)
# Set WHATSAPP_MODE=mock for local simulation; set WHATSAPP_MODE=cloud_api when live credentials available
WHATSAPP_ENABLED=False
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_GRAPH_API_VERSION=v20.0

# Cloudflare Turnstile Spam Protection
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
